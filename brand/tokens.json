{
  "color": {
    "$type": "color",
    "graphite": { "$value": "#1F1F1F", "$description": "From the logo file" },
    "white": { "$value": "#FFFFFF" },
    "paper": { "$value": "#F6F5F2" },
    "stone": {
      "100": { "$value": "#ECEAE5" },
      "200": { "$value": "#DAD7D0" },
      "300": { "$value": "#BDB9B0" },
      "400": { "$value": "#98948B" },
      "500": { "$value": "#76726A" },
      "600": { "$value": "#5C5952" },
      "700": { "$value": "#45433E" },
      "800": { "$value": "#31302C" }
    },
    "blueprint": {
      "100": { "$value": "#E3EAF6" },
      "300": { "$value": "#8FAADB" },
      "500": { "$value": "#2F62BC" },
      "600": { "$value": "#1F4FA3" },
      "700": { "$value": "#193F83" },
      "900": { "$value": "#102850" }
    },
    "status": {
      "success": { "$value": "#1E6B4A" },
      "warning": { "$value": "#8A5A00" },
      "error": { "$value": "#B3261E" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": { "$value": ["Archivo", "Segoe UI", "Arial", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.8rem" },
      "sm": { "$value": "0.9rem" },
      "base": { "$value": "1rem" },
      "md": { "$value": "1.25rem" },
      "lg": { "$value": "1.5625rem" },
      "xl": { "$value": "2.4375rem" },
      "2xl": { "$value": "3.8125rem" }
    }
  },
  "logo": {
    "$type": "dimension",
    "minWidth": { "$value": "120px" },
    "markMinHeight": { "$value": "40px" }
  }
}
